{
    "name": "longitude-one/doctrine-spatial",
    "type": "library",
    "description": "Doctrine multi-platform support for spatial types and functions, compliant with Doctrine 2.19, 3.1, and dev ones (3.2 and 4.0).",
    "keywords": ["orm", "dbal", "database", "postgresql", "mariadb", "mysql", "opengis", "postgis", "gis", "spatial", "geometry", "geography", "iso-13249"],
    "authors": [
        {
            "name": "Derek Lambert",
            "email": "dlambert@dereklambert.com",
            "role": "Historical author"
        },
        {
            "name": "Alexandre Tranchant",
            "email": "alexandre.tranchant@gmail.com",
            "role": "Lead maintainer"
        }
    ],
    "license": "MIT",
    "replace": {
        "creof/doctrine2-spatial": "*"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "longitude-one/geo-parser": "^4.0.0",
        "longitude-one/wkt-parser": "^3.0.1",
        "longitude-one/wkb-parser": "^3.0.1",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "monolog/monolog": "^3.0",
        "phpunit/phpunit": "^13.0",
        "phpunit/phpcov": "^13.0",
        "dg/bypass-finals": "^1.11",
        "symfony/cache": "^7.4"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "quality": [
            "quality/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=quality/php-cs-fixer/.php-cs-fixer.php --allow-risky=yes",
            "quality/php-stan/vendor/bin/phpstan analyse --configuration=quality/php-stan/php-stan.neon lib tests --error-format=table --no-progress --no-interaction --no-ansi --level=9 --memory-limit=256M",
            "quality/php-mess-detector/vendor/bin/phpmd lib text quality/php-mess-detector/ruleset.xml",
            "quality/php-mess-detector/vendor/bin/phpmd tests text quality/php-mess-detector/test-ruleset.xml",
            "quality/php-code-sniffer/vendor/bin/phpcs --standard=quality/php-code-sniffer/phpcs.xml -s"
        ],
        "test-php-only": [
            "phpunit --configuration phpunit.no-database-server.xml"
        ],
        "test": [
            "@test-php-only",
            "@test-mariadb",
            "@test-mysql",
            "@test-pgsql",
            "@test-sqlserver"
        ],
        "test-coverage": [
            "phpunit --configuration phpunit.no-database-server.xml --coverage-php .phpunit.cache/code-coverage/no-database-server.cov",
            "phpunit --configuration phpunit.mariadb.xml --coverage-php .phpunit.cache/code-coverage/mariadb.cov",
            "phpunit --configuration phpunit.mysql.xml --coverage-php .phpunit.cache/code-coverage/mysql.cov",
            "phpunit --configuration phpunit.pgsql.xml --coverage-php .phpunit.cache/code-coverage/pgsql.cov",
            "phpunit --configuration phpunit.sqlserver.xml --coverage-php .phpunit.cache/code-coverage/sqlserver.cov",
            "phpcov merge --clover .phpunit.cache/code-coverage/clover.xml --html .phpunit.cache/code-coverage/html --html-views file,class .phpunit.cache/code-coverage/"
        ],
        "test-local": [
            "@test-coverage",
            "cp .phpunit.cache/code-coverage/clover.xml .phpunit.cache/coverage.xml",
            "sed -i.bak 's|/var/www/|./|g' .phpunit.cache/coverage.xml",
            "rm .phpunit.cache/coverage.xml.bak"
        ],
        "test-mariadb": "phpunit --configuration phpunit.mariadb.xml",
        "test-mysql": "phpunit --configuration phpunit.mysql.xml",
        "test-pgsql": "phpunit --configuration phpunit.pgsql.xml",
        "test-sqlserver": "phpunit --configuration phpunit.sqlserver.xml"
    },
    "autoload": {
        "psr-4": {
            "LongitudeOne\\Spatial\\": "lib/LongitudeOne/Spatial/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LongitudeOne\\Spatial\\Tests\\": "tests/LongitudeOne/Spatial/Tests/"
        }
    },
    "repositories" : [
    ]
}
